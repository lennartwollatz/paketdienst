# Öffentliche URL der SPA — gleicher Ursprung/Sinn wie FRONTEND_URL im Backend.
# Nur Domain möglich (z. B. https://wollatzsmarthome.ddns.net): der Unterpfad kommt dann aus vite `base`.
# Mit vollem Pfad: https://host/paketdienst — sollte zur tatsächlichen Auslieferung passen.
VITE_FRONTEND_URL=http://localhost:5177/paketdienst

# Produktion (Beispiele):
# VITE_FRONTEND_URL=https://wollatzsmarthome.ddns.net
# VITE_FRONTEND_URL=https://wollatzsmarthome.ddns.net/paketdienst

# Backend-API (Development: Port muss mit PORT in backend/.env übereinstimmen, z. B. 3003)
VITE_API_URL=http://localhost:3003/api
# Nur wenn VITE_API_URL leer ist: Fallback-Port für resolveApiBaseUrl() in npm run dev
VITE_BACKEND_PORT=3003
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
