# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Datenbank
DATABASE_URL="file:./dev.db"

# JWT (langen, zufälligen String verwenden)
JWT_SECRET=DEIN_GEHEIMER_JWT_SCHLUESSEL

# Stripe (optional – ohne Stripe läuft Demo-Modus)
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# OpenAI (für automatische Bestellungserkennung)
OPENAI_API_KEY=sk-PLACEHOLDER

# Tracking – Einstellungen
TRACKING_POLLING_ENABLED=false
TRACKING_POLLING_INTERVAL_MS=1800000
TRACKING_PROVIDER_TIMEOUT_MS=12000
TRACKING_ENABLE_LEGACY_FALLBACK=false

# Carrier-APIs (alle optional)
DHL_API_KEY=PLACEHOLDER
DHL_API_SECRET=PLACEHOLDER
DHL_TOKEN_URL=PLACEHOLDER

UPS_CLIENT_ID=PLACEHOLDER
UPS_CLIENT_SECRET=PLACEHOLDER
HERMES_API_KEY=PLACEHOLDER
DPD_CLIENT_ID=PLACEHOLDER
DPD_CLIENT_SECRET=PLACEHOLDER
GLS_API_USERNAME=PLACEHOLDER
GLS_API_PASSWORD=PLACEHOLDER

# E-Mail für Passwort-Reset (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@paketdienst.app
