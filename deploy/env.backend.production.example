# Server (Produktion) — nach dem Kopieren Secrets eintragen (JWT, Stripe, OpenAI, …)
# Muss mit Nginx + systemd übereinstimmen (paketdienst-api :3001)
PORT=3001
NODE_ENV=production
TEST_ACCESS_ENABLED=false
FRONTEND_URL=https://wollatzsmarthome.ddns.net/paketdienst

DATABASE_URL="file:./prod.db"

JWT_SECRET=BITTE_LANGEN_ZUFAELLIGEN_STRING_SETZEN

STRIPE_SECRET_KEY=sk_live_…
STRIPE_PUBLISHABLE_KEY=pk_live_…
STRIPE_WEBHOOK_SECRET=whsec_…

OPENAI_API_KEY=sk-…

TRACKINGMORE_API_KEY=
TRACKINGMORE_DEBUG_LOG=false
TRACKING_POLLING_ENABLED=true
TRACKING_POLLING_INTERVAL_MS=1800000
TRACKING_PROVIDER_TIMEOUT_MS=12000
TRACKING_ENABLE_LEGACY_FALLBACK=false

# Lokales Postfix (siehe deploy/POSTFIX-PASSWORT-RESET.md):
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_FROM=noreply@wollatzsmarthome.ddns.net
# SMTP_USER/SMTP_PASS leer lassen für Postfix auf localhost

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
